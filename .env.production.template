# Production Environment Configuration Template
# Copy this file to .env.production and update the values

# Database Configuration
POSTGRES_DB=socially_prod
POSTGRES_USER=socially_user
POSTGRES_PASSWORD=your_secure_database_password_here

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_256_bits_minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://api.yourdomain.com/api/auth/linkedin/callback

# Frontend URL
FRONTEND_URL=https://yourdomain.com
VITE_API_URL=https://api.yourdomain.com/api

# AI Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# AWS Services
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=socially-prod-uploads

# Email Service (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Monitoring & Analytics
BACKEND_SENTRY_DSN=https://your_backend_sentry_dsn@sentry.io
FRONTEND_SENTRY_DSN=https://your_frontend_sentry_dsn@sentry.io
VITE_SENTRY_DSN=https://your_frontend_sentry_dsn@sentry.io

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_TEAMS=true
VITE_ENABLE_SSO=false

# Security
ENABLE_RATE_LIMITING=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PAYMENTS=true

# Third-party Services
VITE_HOTJAR_ID=your_hotjar_id_here
POSTHOG_API_KEY=your_posthog_api_key_here

# Redis (if using external Redis service)
REDIS_URL=redis://your_redis_host:6379