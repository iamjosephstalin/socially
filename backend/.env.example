# Backend Environment Configuration Example
# Copy this file to .env and update the values

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/socially_db"
# For development with SQLite (uncomment below and comment PostgreSQL above)
# DATABASE_URL="file:./prisma/dev.db"

# JWT Configuration
JWT_SECRET="your-super-secure-jwt-secret-256-bits-minimum"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# LinkedIn OAuth
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_REDIRECT_URI="http://localhost:3002/api/auth/linkedin/callback"

# Server Configuration
PORT=3002
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# AWS Services (Optional - for file uploads)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="socially-dev-uploads"

# Email Service - SendGrid (Optional)
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
FROM_EMAIL="noreply@yourdomain.com"

# Payment Processing - Stripe (Optional)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Monitoring & Error Tracking (Optional)
SENTRY_DSN="https://your_backend_sentry_dsn@sentry.io"
LOG_LEVEL="info"

# Feature Flags
ENABLE_RATE_LIMITING="true"
ENABLE_EMAIL_VERIFICATION="false"
ENABLE_PAYMENTS="false"

# File Upload Configuration
MAX_FILE_SIZE="5242880"
UPLOAD_DIR="./uploads"

# Security (Optional - for production)
SCHEDULER_API_KEY="your_scheduler_api_secret_key"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"